# Bu dosyayı kopyalayıp kendi değerlerinle doldur. Gerçek değerleri GitHub'a yükleme.
# Windows'ta kalıcı tanımlamak için: setx DEGISKEN_ADI "deger"

GROQ_API_KEY=
